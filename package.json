{
  "name": "pkc3",
  "version": "3.2.0",
  "private": true,
  "type": "module",
  "description": "PKC3 — portable single-HTML knowledge container, PKC-Markdown native, wasm-sqlite storage",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:smoke": "playwright test --config tests/smoke/playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests build scripts",
    "build:portable": "vite build --config build/portable.config.ts && node build/portable/fold.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "happy-dom": "^20.12.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "chart.js": "^4.5.1",
    "markdown-it": "15.0.1",
    "markdown-it-footnote": "4.0.0",
    "mermaid": "^11.17.2"
  }
}
