{
  "name": "pkc3",
  "version": "3.2.0",
  "private": true,
  "type": "module",
  "description": "PKC3 — portable single-HTML knowledge container, PKC-Markdown native, wasm-sqlite storage",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:smoke": "playwright test --config tests/smoke/playwright.config.ts",
    "smoke:pick": "node scripts/pick-smoke.mjs --run",
    "smoke:budget": "node scripts/smoke-budget.mjs",
    "smoke:record": "node scripts/smoke-record.mjs",
    "smoke:map": "node scripts/smoke-map.mjs",
    "typecheck": "tsc --noEmit",
    "icons:font": "node scripts/build-icon-font.mjs",
    "lint": "eslint src tests build scripts",
    "build:portable": "vite build --config build/portable.config.ts && node build/portable/fold.mjs",
    "prepare": "node scripts/install-hooks.mjs --quiet"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.1",
    "eslint": "^10.10.0",
    "happy-dom": "^20.14.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "chart.js": "^4.5.1",
    "katex": "^0.18.7",
    "markdown-it": "15.0.1",
    "markdown-it-footnote": "4.0.0",
    "mermaid": "^11.17.2"
  }
}
