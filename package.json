{
  "name": "pkc3",
  "version": "3.5.0",
  "private": true,
  "type": "module",
  "description": "PKC3 — portable single-HTML knowledge container, PKC-Markdown native, wasm-sqlite storage",
  "license": "MIT",
  "author": "sm06224",
  "repository": {
    "type": "git",
    "url": "https://github.com/sm06224/PKC3"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:guards": "node scripts/test-pr.mjs --guards",
    "test:pr": "node scripts/test-pr.mjs",
    "test:smoke": "playwright test --config tests/smoke/playwright.config.ts",
    "smoke:pick": "node scripts/pick-smoke.mjs --run",
    "smoke:budget": "node scripts/smoke-budget.mjs",
    "smoke:record": "node scripts/smoke-record.mjs",
    "smoke:map": "node scripts/smoke-map.mjs",
    "typecheck": "tsc --noEmit",
    "icons:font": "node scripts/build-icon-font.mjs",
    "lint": "eslint src tests build scripts",
    "build:portable": "vite build --config build/portable.config.ts && node build/portable/fold.mjs",
    "prepare": "node scripts/install-hooks.mjs --quiet"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@phosphor-icons/web": "^2.1.2",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "happy-dom": "21.0.4",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.33.1-dev57.0",
    "@shiguredo/rnnoise-wasm": "^2025.1.5",
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "@tailwindcss/browser": "4.3.3",
    "chart.js": "^4.6.1",
    "katex": "^0.19.1",
    "markdown-it": "15.0.3",
    "markdown-it-cjk-friendly": "3.0.0",
    "markdown-it-footnote": "4.0.0",
    "mermaid": "^12.2.0",
    "onnxruntime-web": "^1.31.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.4.299",
    "plotly.js-dist-min": "4.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sucrase": "3.35.1"
  },
  "overrides": {
    "lodash-es": "^4.18.1"
  }
}
