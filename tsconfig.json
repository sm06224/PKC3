{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["vite/client"],
    "paths": {
      "@core/*": ["./src/core/*"],
      "@features/*": ["./src/features/*"],
      "@adapter/*": ["./src/adapter/*"],
      "@runtime/*": ["./src/runtime/*"]
    }
  },
  "include": ["src", "tests", "vite.config.ts"],
  // harvest-from-pkc2.ts は PKC2 リポジトリ(CI に無い)から import する採取スクリプト
  "exclude": ["tests/fixtures/markdown-goldens/harvest-from-pkc2.ts"]
}
